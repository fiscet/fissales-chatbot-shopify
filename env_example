# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-domain.com
SHOPIFY_SCOPES=read_products,read_orders,read_customers,write_products
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# App Configuration
APP_NAME=Fissales Chatbot
APP_VERSION=1.0.0
APP_DESCRIPTION=AI-powered chatbot for Shopify stores

# Firebase Configuration (for Firestore fallback storage)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account_email

# External API Configuration (configured via Shopify app settings)
# EXTERNAL_API_URL and EXTERNAL_API_KEY are now managed through the app settings page

# Development
NODE_ENV=development
