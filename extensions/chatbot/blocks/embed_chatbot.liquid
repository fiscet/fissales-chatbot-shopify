<div id="fissales-chatbot" 
     data-shop="{{ shop.permanent_domain }}"
     data-customer-id="{{ customer.id }}"
    >
  <!-- Toggle button for compact view -->
  <button class="chatbot-open chatbot-toggle">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor">
      <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
  </button>
  
  <div class="chatbot-container" style="display: none;">
    <button class="chatbot-close chatbot-toggle">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M19 13H5v-2h14v2z"/>
      </svg>
    </button>

    <div class="chatbot-avatar">
      <div class="chatbot-avatar-icon">
        <svg viewBox="0 0 24 24" width="60" height="60" fill="currentColor">
          <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
      </div>
      {% if customer %}
        {% assign name = customer.name %}
      {% else %}
        {% assign name = "Guest" %}
      {% endif %}
      <div class="chatbot-avatar-name">AI Assistant</div>
    </div>

    <!-- Messages -->
    <div class="chatbot-messages" id="chatbot-messages">
      <div class="message bot">
        {% if customer %}
          Hi {{ customer.name }}! I'm your AI assistant. How can I help you today?
        {% else %}
          Hi! I'm your AI assistant. How can I help you find what you're looking for?
        {% endif %}
      </div>
    </div>

    <!-- Input Form -->
    <form id="chatbot-form" class="chatbot-form">
      <textarea 
        id="chatbot-input" 
        placeholder="{{ block.settings.placeholder_text | default: 'Type your message here...' }}"
        rows="2"
        required></textarea>
      <button type="submit" id="chatbot-submit-btn">
        <svg class="send-icon" viewBox="0 0 24 24" width="24" height="24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
        <svg class="loading-icon" viewBox="0 0 24 24" width="24" height="24" style="display: none;">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.416" stroke-dashoffset="31.416">
            <animate attributeName="stroke-dasharray" dur="2s" values="0 31.416;15.708 15.708;0 31.416" repeatCount="indefinite"/>
            <animate attributeName="stroke-dashoffset" dur="2s" values="0;-15.708;-31.416" repeatCount="indefinite"/>
          </circle>
        </svg>
      </button>
    </form>
    <div class="credits">Powered by <a href="https://fissales.com" target="_blank">Fissales</a></div>
  </div>
</div>

<style>
  /* Open/Close buttons */
  .chatbot-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    z-index: 100;
  }

  .chatbot-close svg {
    fill: #666;
    transition: fill 0.3s ease;
  }

  .chatbot-close:hover svg {
    fill: #000;
  }

  .chatbot-open {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: {{ block.settings.button_size | default: 60 }}px;
    height: {{ block.settings.button_size | default: 60 }}px;
    border-radius: 50%;
    background: {{ block.settings.button_color | default: '#2563eb' }};
    border: none;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    cursor: pointer;
    z-index: 99;
    padding: 10px;
    transition: transform 0.3s ease;
    color: white;
  }

  .chatbot-open:hover {
    transform: scale(1.1);
  }

  /* Structure */
  .chatbot-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: {{ block.settings.widget_width | default: 350 }}px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    overflow: hidden;
    z-index: 99;
    border: 1px solid #e5e7eb;
  }

  /* Avatar */
  .chatbot-avatar {
    padding: 15px;
    text-align: center;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
  }

  .chatbot-avatar-icon {
    color: {{ block.settings.button_color | default: '#2563eb' }};
    margin-bottom: 8px;
  }

  .chatbot-avatar-name {
    font-weight: 600;
    color: #374151;
    font-size: 14px;
  }

  /* Messages */
  .chatbot-messages {
    height: {{ block.settings.widget_height | default: 300 }}px;
    overflow-y: auto;
    padding: 15px;
    background: #ffffff;
  }

  .message {
    margin-bottom: 10px;
    padding: 8px 12px;
    border-radius: 12px;
    max-width: 80%;
    font-size: 14px;
    line-height: 1.4;
  }

  .message.bot {
    background: #f1f5f9;
    color: #334155;
    margin-right: auto;
  }

  .message.user {
    background: {{ block.settings.button_color | default: '#2563eb' }};
    color: white;
    margin-left: auto;
  }

  /* Form */
  .chatbot-form {
    display: flex;
    padding: 10px;
    border-top: 1px solid #e5e7eb;
    align-items: flex-end;
    background: #ffffff;
  }

  .chatbot-form textarea {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    margin-right: 8px;
    resize: none;
    line-height: 1.4;
    font-family: inherit; 
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .chatbot-form textarea:focus {
    border-color: {{ block.settings.button_color | default: '#2563eb' }};
  }

  .chatbot-form button {
    background: {{ block.settings.button_color | default: '#2563eb' }};
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    display: flex; 
    align-items: center; 
    justify-content: center; 
    height: 40px; 
    width: 40px;
    transition: background-color 0.2s ease;
  }

  .chatbot-form button:hover {
    background: {{ block.settings.button_color | default: '#2563eb' | color_darken: 10 }};
  }

  .chatbot-form button svg {
    fill: currentColor;
    width: 20px;
    height: 20px;
  }

  .chatbot-form button.loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .chatbot-form button.loading .send-icon {
    display: none;
  }

  .chatbot-form button.loading .loading-icon {
    display: block !important;
  }

  .chatbot-form button:not(.loading) .loading-icon {
    display: none !important;
  }

  .credits {
    font-size: 12px;
    padding: 8px 12px;
    text-align: center;
    color: #6b7280;
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
  }

  .credits a {
    color: {{ block.settings.button_color | default: '#2563eb' }};
    text-decoration: none;
  }

  .credits a:hover {
    text-decoration: underline;
  }
</style>

<script>
  // Helper functions for cookie management
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
  }

  function setCookie(name, value, days = 365) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${value}; expires=${expires}; path=/`;
  }

  function getOrCreateSessionId() {
    let sessionId = getCookie('fissales_chatbot_sessionId');
    if (!sessionId) {
      if (window.crypto && window.crypto.randomUUID) {
        sessionId = crypto.randomUUID();
      } else {
        // Fallback for older browsers
        sessionId = Math.random().toString(36).substring(2) + Date.now().toString(36);
      }
      setCookie('fissales_chatbot_sessionId', sessionId);
    }
    return sessionId;
  }

  window.addEventListener('DOMContentLoaded', (event) => {
    const chatbot = document.getElementById('fissales-chatbot');
    const container = chatbot.querySelector('.chatbot-container');
    const buttonOpen = chatbot.querySelector('.chatbot-open');
    const toggles = document.querySelectorAll('.chatbot-toggle');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input');
    const messages = document.getElementById('chatbot-messages');
    const submitBtn = document.getElementById('chatbot-submit-btn');
    
    const shop = chatbot.dataset.shop;
    const customerId = chatbot.dataset.customerId;

    // Get or create sessionId
    const sessionId = getOrCreateSessionId();
    
    // Use our API endpoint
    const apiUrl = '/api/customer-chat';

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const isVisible = container.style.display !== 'none';
        container.style.display = isVisible ? 'none' : 'block';
        buttonOpen.style.transform = isVisible ? 'scale(1)' : 'scale(0)';
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const message = input.value;
      if (!message) return;

      // Add the user message
      addMessage(message, 'user');
      input.value = '';

      // Show loading state
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      input.disabled = true;

      const chatEnvelope = {
        message,
        customerId,
        sessionId
      };

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shop-Domain': shop
          },
          body: JSON.stringify({ chatEnvelope })
        });

        const data = await response.json();
        
        // Add the bot answer
        addMessage(data.response || 'Sorry, I could not process your request.', 'bot');
      } catch (error) {
        console.error('Error:', error);
        addMessage('Sorry, there was an error. Please try again.', 'bot');
      } finally {
        // Hide loading state
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
        input.disabled = false;
        input.focus();
      }
    });

    function addMessage(text, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${type}`;
      messageDiv.textContent = text;
      messages.appendChild(messageDiv);
      messages.scrollTop = messages.scrollHeight;
    }
  });
</script>

{% schema %}
{
  "name": "Fissales Chatbot",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Chatbot Appearance"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#2563eb"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button Size",
      "min": 50,
      "max": 80,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "widget_width",
      "label": "Widget Width",
      "min": 300,
      "max": 450,
      "step": 25,
      "default": 350,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "widget_height",
      "label": "Widget Height",
      "min": 250,
      "max": 400,
      "step": 25,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Chatbot Text"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Type your message here..."
    }
  ]
}
{% endschema %}
