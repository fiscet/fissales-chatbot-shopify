<div id="shopify-chatbot" 
     data-shop="{{ shop.permanent_domain }}"
     data-customer-id="{{ customer.id }}"
    >
      <!-- Toggle button for compact view -->
  <button class="chatbot-open chatbot-toggle">
    <img src="{{ 'chatbot-avatar.jpg' | asset_url }}" alt="AI Assistant" width="40" height="40" />
  </button>
  
  <div class="chatbot-container" style="display: none;">
    <button class="chatbot-close chatbot-toggle">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M19 13H5v-2h14v2z"/>
      </svg>
    </button>

    <div class="chatbot-avatar">
      <img src="{{ 'chatbot-avatar.jpg' | asset_url }}" alt="AI Assistant" width="60" height="60" />
      {% if customer %}
        {% assign name = customer.name %}
      {% else %}
        {% assign name = "Guest" %}
      {% endif %}
      <div class="chatbot-avatar-name">{{ 'chatbot.title' | t: name: name }}</div>
    </div>

    <!-- Answers -->
    <div class="chatbot-messages" id="chatbot-messages">
      <div class="message bot">
        {% if customer %}
          {{ 'chatbot.welcome_user' | t: name: customer.name }}
        {% else %}
          {{ 'chatbot.welcome_guest' | t }}
        {% endif %}
      </div>
    </div>

    <!-- Input Form -->
    <form id="chatbot-form" class="chatbot-form">
      <textarea 
        id="chatbot-input" 
        placeholder="{{ 'chatbot.textbox_placeholder' | t }}"
        rows="2"
        required></textarea>
      <button type="submit" id="chatbot-submit-btn">
        <svg class="send-icon" viewBox="0 0 24 24" width="24" height="24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
        <svg class="loading-icon" viewBox="0 0 24 24" width="24" height="24" style="display: none;">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.416" stroke-dashoffset="31.416">
            <animate attributeName="stroke-dasharray" dur="2s" values="0 31.416;15.708 15.708;0 31.416" repeatCount="indefinite"/>
            <animate attributeName="stroke-dashoffset" dur="2s" values="0;-15.708;-31.416" repeatCount="indefinite"/>
          </circle>
        </svg>
      </button>
    </form>
    <div class="credits">Powered by <a href="https://villma.ai" target="_blank">villma.ai</a></div>
  </div>
</div>

<style>
  /* Open/Close buttons */
  .chatbot-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    cursor: pointer;
    z-index: 100;
  }

  .chatbot-close svg {
    fill: #666;
    transition: fill 0.3s ease;
  }

  .chatbot-close:hover svg {
    fill: #000;
  }

  .chatbot-open {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: white;
    border: none;
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    cursor: pointer;
    z-index: 99;
    padding: 5px;
    transition: transform 0.3s ease;
  }

  .chatbot-open:hover {
    transform: scale(1.1);
  }

  .chatbot-open img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  /* Structure */

  .chatbot-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 350px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    overflow: hidden;
    z-index: 99;
  }

  /* Avatar */

  .chatbot-avatar {
    padding: 15px;
    text-align: center;
    background: #f5f5f5;
  }

  .chatbot-avatar img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
  }

  /* Messages */

  .chatbot-messages {
    height: 300px;
    overflow-y: auto;
    padding: 15px;
  }

  .message {
    margin-bottom: 10px;
    padding: 8px 12px;
    border-radius: 12px;
    max-width: 80%;
  }

  .message.bot {
    background: #f0f0f0;
    margin-right: auto;
  }

  .message.user {
    background: rgb(2 132 199);
    color: white;
    margin-left: auto;
  }

  /* Form */

  .chatbot-form {
    display: flex;
    padding: 10px;
    border-top: 1px solid #eee;
    align-items: flex-end;
  }

  .chatbot-form textarea {
    flex: 1;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    margin-right: 8px;
    resize: none;
    line-height: 1.4;
    font-family: inherit; 
    font-size: inherit; 
  }

  .chatbot-form button {
    background: rgb(2 132 199);
    color: white;
    border: 1px solid white;
    border-radius: 4px;
    padding: 8px;
    cursor: pointer;
    display: flex; 
    align-items: center; 
    justify-content: center; 
    height: 40px; 
    width: 40px; 
  }

  .chatbot-form button svg {
    fill: currentColor;
    width: 24px; /* Controls the size of the SVG */
    height: 24px;
  }

  .chatbot-form button.loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .chatbot-form button.loading .send-icon {
    display: none;
  }

  .chatbot-form button.loading .loading-icon {
    display: block !important;
  }

  .chatbot-form button:not(.loading) .loading-icon {
    display: none !important;
  }

  .credits {
    font-size: small;
    padding: 8px 12px;

    a {
      color: rgb(2 132 199)
    }
  }
</style>

<script>
  // Helper functions for cookie management
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
  }

  function setCookie(name, value, days = 365) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${value}; expires=${expires}; path=/`;
  }

  function getOrCreateSessionId() {
    let sessionId = getCookie('chatbot_sessionId');
    if (!sessionId) {
      if (window.crypto && window.crypto.randomUUID) {
        sessionId = crypto.randomUUID();
      } else {
        // Fallback for older browsers
        sessionId = Math.random().toString(36).substring(2) + Date.now().toString(36);
      }
      setCookie('chatbot_sessionId', sessionId);
    }
    return sessionId;
  }

  window.addEventListener('DOMContentLoaded', (event) => {
    const chatbot = document.getElementById('shopify-chatbot');
    const container = chatbot.querySelector('.chatbot-container');
    const buttonOpen = chatbot.querySelector('.chatbot-open');
    const toggles = document.querySelectorAll('.chatbot-toggle');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input');
    const messages = document.getElementById('chatbot-messages');
    const submitBtn = document.getElementById('chatbot-submit-btn');
    
    const shop = chatbot.dataset.shop;
    const customerId = chatbot.dataset.customerId

    // Get or create sessionId
    const sessionId = getOrCreateSessionId();
    
    // Use our proxy endpoint instead of direct API call
    const apiUrl = `/api/chat`;

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const isVisible = container.style.display !== 'none';
        container.style.display = isVisible ? 'none' : 'block';
        buttonOpen.style.transform = isVisible ? 'scale(1)' : 'scale(0)';
      });
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const message = input.value;
      if (!message) return;

      // Add the user message
      addMessage(message, 'user');
      input.value = '';

      // Show loading state
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      input.disabled = true;

      const chatEnvelope = {
        message,
        customerId,
        sessionId
      }

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shop-Domain': shop
          },
          body: JSON.stringify({ chatEnvelope })
        });

        const data = await response.json();
        
        // Add the bot answer
        addMessage(data.response, 'bot');
      } catch (error) {
        console.error('Error:', error);
        addMessage({{ 'chatbot.errors.default' | t | json }}, 'bot');
      } finally {
        // Hide loading state
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
        input.disabled = false;
        input.focus();
      }
    });

    function addMessage(text, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${type}`;
      messageDiv.textContent = text;
      messages.appendChild(messageDiv);
      messages.scrollTop = messages.scrollHeight;
    }
  });
</script>

{% schema %}
{
  "name": "Chatbot",
  "target": "body",
  "settings": []
}
{% endschema %}