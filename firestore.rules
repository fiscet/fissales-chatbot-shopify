rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== EXISTING APP RULES =====
    // User roles - users can create and read their own role
    match /user_roles/{userId} {
      // Allow users to read their own role
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow users to create their own role during registration
      allow create: if request.auth != null && request.auth.uid == userId;
      // Only allow updates from admin users or the user themselves
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Products - only admin users can access
    match /products/{productId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Company info - only admin users can access
    match /company_info/{companyId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Chat sessions - only server (Admin SDK)
    match /chat_sessions/{sessionId} {
      allow read, write: if false; // Solo Admin SDK
    }
    
    // Product embeddings - only server (Admin SDK)  
    match /product_embeddings/{embeddingId} {
      allow read, write: if false; // Solo Admin SDK
    }
    
    // ===== SHOPIFY CHATBOT APP RULES =====
    // Shopify sessions - only server (Admin SDK) can access
    match /shopify_sessions/{sessionId} {
      allow read, write: if false; // Solo Admin SDK
    }
    
    // Shopify app settings - only server (Admin SDK) can access
    match /shopify_settings/{settingId} {
      allow read, write: if false; // Solo Admin SDK
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
